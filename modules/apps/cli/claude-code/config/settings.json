{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 15,
  "model": "opusplan",
  "smallModelOverride": "haiku",
  "outputStyle": "compact",
  "coAuthor": "",
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "Agent",
      "Skill",

      "Bash(nix *)",
      "Bash(nix-*)",
      "Bash(statix check *)",
      "Bash(statix fix *)",
      "Bash(deadnix *)",
      "Bash(nixfmt *)",
      "Bash(darwin-rebuild check *)",
      "Bash(darwin-rebuild build *)",

      "Bash(git *)",
      "Bash(gh *)",

      "Bash(echo *)",
      "Bash(printf *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(touch *)",
      "Bash(chmod *)",
      "Bash(cat *)",
      "Bash(bat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(less *)",
      "Bash(wc *)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(tree *)",
      "Bash(find *)",
      "Bash(fd *)",
      "Bash(file *)",
      "Bash(stat *)",
      "Bash(realpath *)",
      "Bash(readlink *)",
      "Bash(du *)",
      "Bash(df *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(awk *)",
      "Bash(sed *)",
      "Bash(tr *)",
      "Bash(cut *)",
      "Bash(diff *)",
      "Bash(jq *)",
      "Bash(yq *)",
      "Bash(xargs *)",
      "Bash(which *)",
      "Bash(command *)",
      "Bash(type *)",
      "Bash(uname *)",
      "Bash(whoami)",
      "Bash(pwd)",
      "Bash(date *)",
      "Bash(id)",
      "Bash(id *)",
      "Bash(hostname)",
      "Bash(test *)",
      "Bash([ *)",

      "Bash(go *)",
      "Bash(cargo *)",
      "Bash(rustc *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(pip *)",
      "Bash(shellcheck *)",
      "Bash(just)",
      "Bash(just *)",
      "Bash(fish *)",
      "Bash(bash *)",

      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(ping *)",
      "Bash(dig *)",
      "Bash(nslookup *)",
      "Bash(tar *)",
      "Bash(unzip *)",
      "Bash(gzip *)",

      "Bash(sw_vers*)",
      "Bash(scutil --get *)",
      "Bash(sysctl -n *)",
      "Bash(system_profiler *)",
      "Bash(ioreg *)",
      "Bash(pmset -g*)",
      "Bash(diskutil list*)",
      "Bash(launchctl list*)",
      "Bash(launchctl print*)",
      "Bash(pgrep *)",
      "Bash(defaults read *)",
      "Bash(mdls *)",
      "Bash(mdfind *)",
      "Bash(pkgutil --pkgs*)",
      "Bash(pkgutil --pkg-info*)",
      "Bash(codesign -d*)",
      "Bash(open *)",
      "Bash(ghostty *)",
      "Bash(tmux *)",

      "Bash(brew list*)",
      "Bash(brew info*)",
      "Bash(brew search*)",
      "Bash(brew outdated*)",
      "Bash(brew tap)",
      "Bash(brew bundle dump*)"
    ],
    "deny": [
      "Bash(darwin-rebuild switch *)",
      "Bash(darwin-rebuild activate *)",
      "Bash(nix-collect-garbage *)",
      "Bash(brew install *)",
      "Bash(brew uninstall *)",
      "Bash(brew upgrade *)",
      "Bash(printenv*)",
      "Bash(op read*)",
      "Bash(op item get*--reveal*)"
    ],
    "ask": [
      "Bash(sudo *)"
    ]
  },
  "env": {
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-5",
    "SSH_AUTH_SOCK": "@HOME_DIR@/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock",
    "PATH": "/etc/profiles/per-user/@USER_NAME@/bin:/run/current-system/sw/bin:/opt/homebrew/bin:${PATH}",
    "DISABLE_AUTOUPDATER": "1"
  },
  "feedbackSurveyRate": 0,
  "feedbackDrafts": "off",
  "awaySummaryEnabled": false,
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "skipAutoPermissionPrompt": true,
  "terminalProgressBarEnabled": true,
  "todoFeatureEnabled": false,
  "agentPushNotifEnabled": true,
  "remoteControlEnabled": true
}
